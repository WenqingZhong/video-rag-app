# Values here target a local (host) run: `make run` / `make worker` against `make start` services.
# compose.yml overrides the hosts for containers, so the same file works for both.

# Application Settings
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
SERVICE_NAME=video-rag-api

# PostgreSQL Database Configuration
POSTGRES_DATABASE_URL=postgresql+psycopg2://video_rag:video_rag_password@localhost:5432/video_rag
POSTGRES_ECHO_SQL=false
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0

# Redis Configuration (db 0: cache)
REDIS_URL=redis://localhost:6379/0

# Celery Worker Configuration (db 1: broker, db 2: results)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# S3-compatible Object Storage (SeaweedFS locally; leave S3_ENDPOINT_URL empty for AWS S3)
# Credentials must match infra/seaweedfs/s3.json
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=video_rag
S3_SECRET_KEY=video_rag_secret
S3_REGION=us-east-1
S3_BUCKET=video-rag

# Pexels (free key: https://www.pexels.com/api/)
PEXELS_API_KEY=
PEXELS_MAX_DURATION_SEC=60
PEXELS_MAX_HEIGHT=720

# Uploads
UPLOAD_MAX_MB=500

# Video processing (worker)
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
SCENE_THRESHOLD=0.3

# Visual search: CLIP embedding service + Ollama vision model for captions
EMBEDDER_URL=http://localhost:8001
CAPTION_MODEL=qwen2.5vl:3b

# Token usage: every model call is recorded in llm_calls. The models run locally; cost is an estimate
# at a hosted model's list price (USD per million tokens).
USAGE_TRACKING_ENABLED=true
LLM_PRICE_REFERENCE=Claude Haiku 4.5 list price
LLM_PRICE_INPUT_PER_MTOK=1.00
LLM_PRICE_OUTPUT_PER_MTOK=5.00

# OpenSearch Configuration
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX=video_segments

# Where the models run. ollama: local development (the Ollama container, models by name above).
# bedrock: production on AWS. Model ids from the Bedrock console (Model catalog → Model ID, or an inference profile
# id "us.<model id>"); the account needs access to them. Credentials: the usual AWS chain (IAM role, AWS_PROFILE).
LLM_PROVIDER=ollama
# BEDROCK_REGION=us-east-1
# BEDROCK_TEXT_MODEL_ID=
# BEDROCK_VISION_MODEL_ID=

# Telegram bot: token from @BotFather. Never commit it. Empty allow-list = anyone who finds the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=llama3.2:1b
OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=300
