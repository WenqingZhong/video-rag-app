    {
      "type": "table",
      "title": "Time per step (from traces)",
      "description": "Every timed step of API requests and worker tasks (stage.* = ingestion, llm.* = model calls).",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "video-rag-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "video-rag-postgres"
          },
          "rawSql": "SELECT service, name AS step, count(*) AS count, round(percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms)::numeric) AS \"p50 ms\", round(percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms)::numeric) AS \"p95 ms\", round(max(duration_ms)::numeric) AS \"max ms\", count(*) FILTER (WHERE status = 'error') AS errors FROM trace_spans WHERE $__timeFilter(started_at) GROUP BY service, name ORDER BY \"p95 ms\" DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 13
    },
    {
      "type": "table",
      "title": "Slowest requests and tasks",
      "description": "Click a trace id to open its timeline (GET /api/v1/traces/{id}).",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "video-rag-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "video-rag-postgres"
          },
          "rawSql": "SELECT started_at AS time, name, service, round(duration_ms::numeric) AS \"ms\", status, trace_id AS trace FROM trace_spans WHERE $__timeFilter(started_at) AND parent_id IS NULL ORDER BY duration_ms DESC LIMIT 25",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "http://localhost:8000/api/v1/traces/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 14
    },
    {
      "type": "table",
      "title": "Recent errors",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "video-rag-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "video-rag-postgres"
          },
          "rawSql": "SELECT started_at AS time, name, service, error, trace_id AS trace FROM trace_spans WHERE $__timeFilter(started_at) AND status = 'error' ORDER BY started_at DESC LIMIT 25",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "http://localhost:8000/api/v1/traces/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 15
    }
