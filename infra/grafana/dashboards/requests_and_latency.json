{
  "uid": "video-rag-requests",
  "title": "Requests & latency",
  "description": "Live request behaviour (Prometheus) and time per step (traces in Postgres).",
  "tags": [
    "video-rag"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "/ask requests",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "video-rag-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "video-rag-prometheus"
          },
          "expr": "sum(increase(ask_requests_total[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 1
    },
    {
